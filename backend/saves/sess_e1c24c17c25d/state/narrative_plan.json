    {
      "consumed": false,
      "directive": {
        "content": "Look at all the veterans here... It makes me realize how much we've grown since we first met. What do you think is the most important thing for a party to stay together?",
        "kind": "talk"
      },
      "expires_at_tick": 40,
      "issued_at_tick": 32,
      "linked_quest_id": null,
      "npc_id": "priestess",
